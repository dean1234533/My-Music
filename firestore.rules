rules_version = '2';

// My Music — a personal, YouTube-powered music library and player.
// The data model is intentionally tiny: everything except the shared
// `tracks` metadata cache is private to the signed-in user who owns it.
// No marketplace, no admin roles, no payments — just a library, playlists,
// favorites, play history, and per-user settings.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwner(field) {
      return isSignedIn() && request.auth.uid == field;
    }

    // ---------------------------------------------------------------------
    // users/{uid} — private account document, doc ID == uid. Normally
    // created server-side by the auth-trigger Cloud Function
    // (functions/src/users.ts), but ensureUserDocument() in
    // src/services/userService.ts can also create it client-side as a
    // fallback if the trigger hasn't run yet, so client create is allowed
    // too as long as the doc ID matches the caller's own uid.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read, update: if isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // tracks/{youtubeVideoId} — shared cache of YouTube metadata, keyed by
    // its own video ID so the same video is never duplicated across two
    // docs. This is just cached public YouTube metadata, not personal data,
    // so any signed-in user may create or read a track doc — but the doc ID
    // must equal the track's own youtubeVideoId, and that ID must look like
    // a real YouTube video ID. Once created, the identity fields
    // (youtubeVideoId/source/createdAt) can never change. `unavailable` may
    // only be flipped false -> true (the player marking a video as gone),
    // never reset back to false from a client. No client delete.
    // ---------------------------------------------------------------------
    match /tracks/{trackId} {
      allow read: if true;

      allow create: if isSignedIn()
        && trackId == request.resource.data.youtubeVideoId
        && trackId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.source == 'youtube';

      allow update: if isSignedIn()
        && request.resource.data.youtubeVideoId == resource.data.youtubeVideoId
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.get('unavailable', false) != true
        // Every other field may change freely (refreshed title/thumbnail/
        // duration/etc); only `unavailable` may ever flip, and only false -> true.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unavailable', 'updatedAt'])
        && request.resource.data.unavailable == true;

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // playlists/{playlistId} — owner-only. Auto-generated doc ID; ownership
    // is a field check (ownerId), matching src/services/playlistService.ts.
    // ---------------------------------------------------------------------
    match /playlists/{playlistId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // ---------------------------------------------------------------------
    // favorites/{uid}_{trackId} — owner-only, doc ID encodes ownership so a
    // track can only ever be favorited once per user.
    // ---------------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid)
        && favoriteId == request.resource.data.uid + '_' + request.resource.data.trackId;
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // savedTracks/{uid}_{trackId} — a user's independent library, separate
    // from favorites/playlists (a track can be saved without being liked or
    // in any playlist). Same owner-encoded-doc-ID pattern as favorites, so
    // saving the same track twice is a no-op overwrite, never a duplicate.
    // ---------------------------------------------------------------------
    match /savedTracks/{savedId} {
      allow read, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid)
        && savedId == request.resource.data.uid + '_' + request.resource.data.trackId;
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // playHistory/{historyId} — owner-only, auto-generated doc ID. Entries
    // are immutable once written: create or delete only, never update.
    // ---------------------------------------------------------------------
    match /playHistory/{historyId} {
      allow read, delete: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // settings/{uid} — owner-only, doc ID == uid.
    // ---------------------------------------------------------------------
    match /settings/{uid} {
      allow read, write: if isSelf(uid);
    }

    // ---------------------------------------------------------------------
    // rateLimits/{key} — Cloud-Function-only abuse-throttle counters (see
    // functions/src/rateLimit.ts, used by the YouTube search rate limit).
    // Never client-readable or writable.
    // ---------------------------------------------------------------------
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // Everything else no longer exists in this app — deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
