rules_version = '2';

// My Music has no client-facing Storage usage at all. Tracks are YouTube
// links (no hosted audio/artwork upload pipeline), and the one remaining
// path — exports/{uid}/*.json, written by the exportUserData Cloud Function
// (functions/src/account/exportUserData.ts) — is only ever accessed through
// a short-lived signed URL handed back by that callable, never a direct
// client read/write. So every path is denied to clients.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
